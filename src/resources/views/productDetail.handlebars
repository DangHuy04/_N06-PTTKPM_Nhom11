<div class="container product-detail">
    <div class="product-grid">
        <!-- Phần hình ảnh sản phẩm -->
        <div class="product-image">
            <img id="productImage" src="{{image}}" alt="{{name}}">
        </div>

        <!-- Phần thông tin sản phẩm -->
        <div class="product-info">
            <h1>{{name}}</h1>
            <p class="price" id="productPrice">{{price}}</p>

            <!-- Phần chọn cấu hình -->
            <div class="product-options">
                {{#if specsDisplay.items.storage}}
                <div class="option-group">
                    <h3>Bộ nhớ</h3>
                    <div class="storage-options">
                        {{#each specsDisplay.items.storage}}
                        <button class="option-btn storage-btn" data-storage="{{this}}">{{this}}</button>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{#if specsDisplay.items.color}}
                <div class="option-group">
                    <h3>Màu sắc</h3>
                    <div class="color-options">
                        {{#each specsDisplay.items.color}}
                        <button class="option-btn color-btn" data-color="{{this}}">
                            <span class="color-circle" style="background-color: {{this}}"></span>
                            {{this}}
                        </button>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- Trạng thái còn hàng -->
            <div class="stock {{#if stock}}in-stock{{else}}out-of-stock{{/if}}">
                {{#if stock}}Còn hàng{{else}}Hết hàng{{/if}}
            </div>

            <!-- Thông số kỹ thuật -->
            <div class="specs">
                <h2>Thông số kỹ thuật</h2>
                <ul>
                    {{#if (eq specsDisplay.type 'iphone')}}
                    {{#if specsDisplay.items.camera}}
                    <li><span class="spec-label">Camera:</span> <span
                            class="spec-value">{{specsDisplay.items.camera}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.battery}}
                    <li><span class="spec-label">Pin:</span> <span
                            class="spec-value">{{specsDisplay.items.battery}}</span></li>
                    {{/if}}
                    {{else}}
                    {{#if specsDisplay.items.chip}}
                    <li><span class="spec-label">Chip:</span> <span
                            class="spec-value">{{specsDisplay.items.chip}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.ram}}
                    <li><span class="spec-label">RAM:</span> <span class="spec-value">{{specsDisplay.items.ram}}</span>
                    </li>
                    {{/if}}
                    {{#if specsDisplay.items.screen}}
                    <li><span class="spec-label">Màn hình:</span> <span
                            class="spec-value">{{specsDisplay.items.screen}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.weight}}
                    <li><span class="spec-label">Trọng lượng:</span> <span
                            class="spec-value">{{specsDisplay.items.weight}}</span></li>
                    {{/if}}
                    {{/if}}
                </ul>
            </div>

            <!-- Mô tả sản phẩm -->
            <div class="description">
                <h2>Mô tả sản phẩm</h2>
                <p>{{description}}</p>
            </div>

            <!-- Nút mua hàng -->
            <div class="actions">
                <button class="button primary">Mua ngay</button>
                <button class="button secondary">Thêm vào giỏ hàng</button>
            </div>
        </div>
    </div>
</div>



{{!-- Related Products Section --}}
<div class="container">
    <b>
        <h1>Sản phẩm tương tự</h1>
    </b>
    <div class="grid">
        {{#each products}}
        <a href="/{{productId}}" class="card-link">
            <div class="card">
                {{#if discount}}
                <div class="badge discount">{{discount}}</div>
                {{/if}}
                {{#if installment}}
                <div class="badge installment">{{installment}}</div>
                {{/if}}
                <img src="{{image}}" alt="{{name}}">
                <h2>{{name}}</h2>
                <p class="price">{{price}}</p>
                {{#if oldPrice}}
                <p class="old-price">{{oldPrice}}</p>
                {{/if}}
            </div>
        </a>
        {{/each}}
    </div>
</div>

{{!-- Tabs Section --}}
<div class="container">
    <div class="tabs">
        <button class="tab-button active" data-tab="description">Mô tả</button>
        <button class="tab-button" data-tab="specs">Thông số kỹ thuật</button>
        <button class="tab-button" data-tab="reviews">Đánh giá</button>
    </div>

    <div class="tab-content">

        <!-- Tab Mô tả: Hiển thị các hình ảnh theo hàng dọc và mô tả chung -->
        <div id="description" class="tab-pane active">
            <div class="description-images">
                {{#each images}}
                <img src="{{this}}" alt="{{../name}}" class="img-fluid mb-3" style="max-width: 100%; display: block;" />
                {{/each}}
            </div>
        </div>


        <!-- Tab Thông số kỹ thuật: Hiển thị các thông số chi tiết -->
        <div id="specs" class="tab-pane">
            <h2>Thông số kỹ thuật</h2>
            <ul class="specs-list" style="list-style: none; padding: 0;">
                {{#if specsDisplay.items.screen}}
                <li><strong>Màn hình:</strong> {{specsDisplay.items.screen}}</li>
                {{/if}}
                {{#if specsDisplay.items.camera}}
                <li><strong>Camera:</strong> {{specsDisplay.items.camera}}</li>
                {{/if}}
                {{#if specsDisplay.items.cpu}}
                <li><strong>CPU:</strong> {{specsDisplay.items.cpu}}</li>
                {{/if}}
                {{#if specsDisplay.items.sim}}
                <li><strong>SIM:</strong> {{specsDisplay.items.sim}}</li>
                {{/if}}
                {{#if specsDisplay.items.connectivity}}
                <li><strong>Kết nối:</strong> {{specsDisplay.items.connectivity}}</li>
                {{/if}}
                {{#if specsDisplay.items.designWeight}}
                <li><strong>Thiết kế và trọng lượng:</strong> {{specsDisplay.items.designWeight}}</li>
                {{/if}}
                {{#if specsDisplay.items.batteryCharging}}
                <li><strong>Pin và sạc:</strong> {{specsDisplay.items.batteryCharging}}</li>
                {{/if}}
                {{#if specsDisplay.items.additionalInfo}}
                <li><strong>Thông tin khác:</strong> {{specsDisplay.items.additionalInfo}}</li>
                {{/if}}
            </ul>
        </div>
    </div>


    <div id="reviews" class="tab-pane">
        {{!-- productDetail.handlebars --}}
        <div class="container reviews-section">
            <h1 style="margin-left: 3.5vw;">Đánh giá sản phẩm</h1>
            <div class="reviews-grid">
                <!-- Cột bên trái: Tổng hợp đánh giá và form -->
                <div class="reviews-summary">
                    <div class="rating-card">
                        <div class="rating-average">
                            <span class="rating-number">{{reviews.averageRating}}</span>
                            <span class="total-reviews">{{reviews.totalReviews}} đánh giá</span>
                        </div>
                        <div class="rating-bars">
                            {{#each reviews.ratingCounts}}
                            <div class="rating-bar">
                                <span class="star-count">{{stars}}</span>
                                <div class="progress">
                                    <div class="progress-bar" style="width: {{percentage}}%"></div>
                                </div>
                            </div>
                            {{/each}}
                        </div>
                    </div>

                    <div class="review-form">
                        <h2>Viết đánh giá của bạn</h2>
                        {{#if user}}
                        <form id="reviewForm" action="/reviews" method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="category" value="{{category}}">
                            <input type="hidden" name="productId" value="{{productId}}">

                            <!-- Thanh rating cho người dùng -->
                            <div class="rating-select">
                                <span>Chất lượng*:</span>
                                <div class="stars">
                                    <!-- Đặt star5 trước star1 trong DOM -->
                                    <input type="radio" id="star5" name="rating" value="5" checked>
                                    <label for="star5"><i class="bi bi-star-fill"></i></label>

                                    <input type="radio" id="star4" name="rating" value="4">
                                    <label for="star4"><i class="bi bi-star-fill"></i></label>

                                    <input type="radio" id="star3" name="rating" value="3">
                                    <label for="star3"><i class="bi bi-star-fill"></i></label>

                                    <input type="radio" id="star2" name="rating" value="2">
                                    <label for="star2"><i class="bi bi-star-fill"></i></label>

                                    <input type="radio" id="star1" name="rating" value="1">
                                    <label for="star1"><i class="bi bi-star-fill"></i></label>
                                </div>
                            </div>

                            <div class="form-group">
                                <h2>Tên của bạn:</h2>
                                <input type="text" name="name" value="{{user.username}}" readonly>
                            </div>

                            <div class="form-group">
                                <h2>Nội dung đánh giá:</h2>
                                <textarea name="comment" placeholder="Nhập đánh giá của bạn" required></textarea>
                            </div>

                            <div class="form-group">
                                <label class="upload-btn">
                                    <i class="bi bi-upload"></i> Upload hình ảnh
                                    <input type="file" id="reviewImageInput" name="image" accept="image/*" hidden>
                                </label>
                                <!-- Khu vực preview ảnh -->
                                <div class="image-preview-container">
                                    <img id="imagePreview" alt="Preview" style="display: none;">
                                </div>
                            </div>

                            <button type="submit" class="submit-btn">Gửi</button>
                        </form>

                        {{else}}
                        <p>Vui lòng <a href="/login">đăng nhập</a> để đánh giá</p>
                        {{/if}}
                    </div>
                </div>

                <!-- Cột bên phải: Danh sách đánh giá -->
                <div class="reviews-list">
                    {{#each reviews.list}}
                    <div class="review-item">
                        <div class="review-avatar">
                            {{#if avatar}}
                            <img src="{{avatar}}" alt="{{name}}">
                            {{else}}
                            <i class="bi bi-person-circle"></i>
                            {{/if}}
                        </div>
                        <div class="review-content">
                            <div class="review-header">
                                <h3>{{name}} <span class="review-date">{{createdAt}}</span></h3>
                            </div>
                            <div class="review-rating">
                                <div class="stars">
                                    {{#times rating}}
                                    <i class="bi bi-star-fill"></i>
                                    {{/times}}
                                </div>
                                <p>{{comment}}</p>
                            </div>
                            {{#if image}}
                            <div class="review-image">
                                <img src="{{image}}" alt="Review image">
                            </div>
                            {{/if}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>
        </div>

    </div>
</div>


{{!-- Fixed Buttons --}}
<div class="fixed-buttons">
    <a href="tel:+123456789" class="hotline">
        <i class="bi bi-telephone"></i>
    </a>
    <a href="mailto:example@example.com" class="comment">
        <i class="bi bi-chat-dots"></i>
    </a>
</div>

<link rel="stylesheet" href="../css/productDetail.css">

{{!-- Script xử lý tabs và variants --}}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        /* --- Tab Switching và Variants --- */
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabPanes = document.querySelectorAll('.tab-pane');
        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                tabButtons.forEach(btn => btn.classList.remove('active'));
                tabPanes.forEach(pane => pane.classList.remove('active'));
                button.classList.add('active');
                const tabId = button.getAttribute('data-tab');
                document.getElementById(tabId).classList.add('active');
            });
        });

        const variants = {{{ variants }}}; // Dữ liệu variants từ server
    const storageButtons = document.querySelectorAll('.storage-btn');
    const colorButtons = document.querySelectorAll('.color-btn');
    const productImage = document.getElementById('productImage');
    const productPrice = document.getElementById('productPrice');
    const stockStatus = document.querySelector('.stock');

    let selectedStorage = '';
    let selectedColor = '';

    function updateProduct() {
        const variant = variants.find(v => v.storage === selectedStorage && v.color === selectedColor);
        if (variant) {
            productImage.src = variant.image;
            productPrice.textContent = variant.price.toLocaleString() + 'đ';
            if (variant.stock > 0) {
                stockStatus.className = 'stock in-stock';
                stockStatus.textContent = 'Còn hàng';
            } else {
                stockStatus.className = 'stock out-of-stock';
                stockStatus.textContent = 'Hết hàng';
            }
        }
    }

    storageButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            storageButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            selectedStorage = btn.dataset.storage;
            updateProduct();
        });
    });

    colorButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            colorButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            selectedColor = btn.dataset.color;
            updateProduct();
        });
    });

    if (storageButtons.length) storageButtons[0].click();
    if (colorButtons.length) colorButtons[0].click();

    /* --- Review Form: Rating Preview và AJAX Submission --- */
    const reviewForm = document.getElementById('reviewForm');
    if (reviewForm) {
        // 2.1. Preview ảnh
        const imageInput = document.getElementById('reviewImageInput');
        const imagePreview = document.getElementById('imagePreview');
        if (imageInput && imagePreview) {
            imageInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (!file) {
                    imagePreview.style.display = 'none';
                    imagePreview.src = '';
                    return;
                }
                const url = URL.createObjectURL(file);
                imagePreview.src = url;
                imagePreview.style.display = 'block';
            });
        }

        // 2.2. Gửi form bằng AJAX
        reviewForm.addEventListener('submit', async function (e) {
            e.preventDefault();
            const formData = new FormData(reviewForm);
            try {
                const response = await fetch(reviewForm.action, {
                    method: reviewForm.method,
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    addNewReview(result.review);
                    reviewForm.reset();
                    // Ẩn preview ảnh sau khi reset
                    if (imagePreview) {
                        imagePreview.style.display = 'none';
                        imagePreview.src = '';
                    }
                } else {
                    alert(result.message);
                }
            } catch (error) {
                console.error('Error submitting review:', error);
                alert('Có lỗi xảy ra khi gửi đánh giá');
            }
        });
    }

    // Hàm thêm review mới vào danh sách (bên phải)
    function addNewReview(review) {
        const reviewsList = document.querySelector('.reviews-list');
        if (!reviewsList) return;
        const reviewElement = document.createElement('div');
        reviewElement.className = 'review-item';
        reviewElement.innerHTML = `
      <div class="review-avatar">
        ${review.avatar ? `<img src="${review.avatar}" alt="${review.name}">` : '<i class="bi bi-person-circle"></i>'}
      </div>
      <div class="review-content">
        <div class="review-header">
          <h3>${review.name} <span class="review-date">${new Date().toLocaleDateString()}</span></h3>
        </div>
        <div class="review-rating">
          <div class="stars">
            <!-- Hiển thị sao đã chọn, ví dụ ★ x n -->
            ${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}
          </div>
          <p>${review.comment}</p>
        </div>
        ${review.image ? `<div class="review-image"><img src="${review.image}" alt="Review image"></div>` : ''}
      </div>
    `;
        reviewsList.insertBefore(reviewElement, reviewsList.firstChild);
    }
});
</script>