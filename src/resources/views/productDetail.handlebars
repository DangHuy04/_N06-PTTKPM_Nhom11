<div class="container product-detail">
    <div class="product-grid">
        <!-- Phần hình ảnh sản phẩm -->
        <div class="product-image">
            <img id="productImage" src="{{image}}" alt="{{name}}">
        </div>

        <!-- Phần thông tin sản phẩm -->
        <div class="product-info">
            <h1>{{name}}</h1>
            <p class="price" id="productPrice">{{price}}</p>

            <!-- Phần chọn cấu hình -->
            <div class="product-options">
                {{#if specsDisplay.items.storage}}
                <div class="option-group">
                    <h3>Bộ nhớ</h3>
                    <div class="storage-options">
                        {{#each specsDisplay.items.storage}}
                        <button class="option-btn storage-btn" data-storage="{{this}}">{{this}}</button>
                        {{/each}}
                    </div>
                </div>
                {{/if}}

                {{#if specsDisplay.items.color}}
                <div class="option-group">
                    <h3>Màu sắc</h3>
                    <div class="color-options">
                        {{#each specsDisplay.items.color}}
                        <button class="option-btn color-btn" data-color="{{this}}">
                            <span class="color-circle" style="background-color: {{this}}"></span>
                            {{this}}
                        </button>
                        {{/each}}
                    </div>
                </div>
                {{/if}}
            </div>

            <!-- Trạng thái còn hàng -->
            <div class="stock {{#if stock}}in-stock{{else}}out-of-stock{{/if}}">
                {{#if stock}}Còn hàng{{else}}Hết hàng{{/if}}
            </div>

            <!-- Thông số kỹ thuật -->
            <div class="specs">
                <h2>Thông số kỹ thuật</h2>
                <ul>
                    {{#if (eq specsDisplay.type 'iphone')}}
                    {{#if specsDisplay.items.camera}}
                    <li><span class="spec-label">Camera:</span> <span
                            class="spec-value">{{specsDisplay.items.camera}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.battery}}
                    <li><span class="spec-label">Pin:</span> <span
                            class="spec-value">{{specsDisplay.items.battery}}</span></li>
                    {{/if}}
                    {{else}}
                    {{#if specsDisplay.items.chip}}
                    <li><span class="spec-label">Chip:</span> <span
                            class="spec-value">{{specsDisplay.items.chip}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.ram}}
                    <li><span class="spec-label">RAM:</span> <span class="spec-value">{{specsDisplay.items.ram}}</span>
                    </li>
                    {{/if}}
                    {{#if specsDisplay.items.screen}}
                    <li><span class="spec-label">Màn hình:</span> <span
                            class="spec-value">{{specsDisplay.items.screen}}</span></li>
                    {{/if}}
                    {{#if specsDisplay.items.weight}}
                    <li><span class="spec-label">Trọng lượng:</span> <span
                            class="spec-value">{{specsDisplay.items.weight}}</span></li>
                    {{/if}}
                    {{/if}}
                </ul>
            </div>

            <!-- Mô tả sản phẩm -->
            <div class="description">
                <h2>Mô tả sản phẩm</h2>
                <p>{{description}}</p>
            </div>

            <!-- Nút mua hàng -->
            <div class="actions">
                <button class="button primary">Mua ngay</button>
                <button onclick="addToCart('{{prodID}}')" class="button secondary">Thêm vào giỏ hàng</button>
            </div>
        </div>
    </div>
</div>



{{!-- Related Products Section --}}
<div class="container">
    <b>
        <h1>Sản phẩm tương tự</h1>
    </b>
    <div class="grid">
        {{#each products}}
        <a href="/{{prodID}}" class="card-link">
            <div class="card">
                {{#if discount}}
                <div class="badge discount">{{discount}}</div>
                {{/if}}
                {{#if installment}}
                <div class="badge installment">{{installment}}</div>
                {{/if}}
                <img src="{{image}}" alt="{{name}}">
                <h2>{{name}}</h2>
                <p class="price">{{price}}</p>
                {{#if oldPrice}}
                <p class="old-price">{{oldPrice}}</p>
                {{/if}}
            </div>
        </a>
        {{/each}}
    </div>
</div>

{{!-- Tabs Section --}}
<div class="container">
    <div class="tabs">
        <button class="tab-button active" data-tab="description">Mô tả</button>
        <button class="tab-button" data-tab="specs">Thông số kỹ thuật</button>
        <button class="tab-button" data-tab="reviews">Đánh giá</button>
    </div>

    <div class="tab-content">

        <!-- Tab Mô tả: Hiển thị các hình ảnh theo hàng dọc và mô tả chung -->
        <div id="description" class="tab-pane active">
            <div class="description-images">
                {{#each images}}
                <img src="{{this}}" alt="{{../name}}" class="img-fluid mb-3" style="max-width: 100%; display: block;" />
                {{/each}}
            </div>
        </div>


        <!-- Tab Thông số kỹ thuật: Hiển thị các thông số chi tiết -->
        <div id="specs" class="tab-pane">
            <h2>Thông số kỹ thuật</h2>
            <ul class="specs-list" style="list-style: none; padding: 0;">
                {{#if specsDisplay.items.screen}}
                <li><strong>Màn hình:</strong> {{specsDisplay.items.screen}}</li>
                {{/if}}
                {{#if specsDisplay.items.camera}}
                <li><strong>Camera:</strong> {{specsDisplay.items.camera}}</li>
                {{/if}}
                {{#if specsDisplay.items.cpu}}
                <li><strong>CPU:</strong> {{specsDisplay.items.cpu}}</li>
                {{/if}}
                {{#if specsDisplay.items.sim}}
                <li><strong>SIM:</strong> {{specsDisplay.items.sim}}</li>
                {{/if}}
                {{#if specsDisplay.items.connectivity}}
                <li><strong>Kết nối:</strong> {{specsDisplay.items.connectivity}}</li>
                {{/if}}
                {{#if specsDisplay.items.designWeight}}
                <li><strong>Thiết kế và trọng lượng:</strong> {{specsDisplay.items.designWeight}}</li>
                {{/if}}
                {{#if specsDisplay.items.batteryCharging}}
                <li><strong>Pin và sạc:</strong> {{specsDisplay.items.batteryCharging}}</li>
                {{/if}}
                {{#if specsDisplay.items.additionalInfo}}
                <li><strong>Thông tin khác:</strong> {{specsDisplay.items.additionalInfo}}</li>
                {{/if}}
            </ul>
        </div>
    </div>


    <div id="reviews" class="tab-pane">
        {{>review}}
    </div>
</div>


{{!-- Fixed Buttons --}}
<div class="fixed-buttons">
    <a href="tel:+123456789" class="hotline">
        <i class="bi bi-telephone"></i>
    </a>
    <a href="mailto:example@example.com" class="comment">
        <i class="bi bi-chat-dots"></i>
    </a>
</div>

<link rel="stylesheet" href="../css/productDetail.css">

{{!-- Script xử lý tabs và variants --}}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        /* --- Tab Switching và Variants --- */
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabPanes = document.querySelectorAll('.tab-pane');
        tabButtons.forEach(button => {
            button.addEventListener('click', () => {
                tabButtons.forEach(btn => btn.classList.remove('active'));
                tabPanes.forEach(pane => pane.classList.remove('active'));
                button.classList.add('active');
                const tabId = button.getAttribute('data-tab');
                document.getElementById(tabId).classList.add('active');
            });
    });

    const variants = {{{ variants }}}; // Dữ liệu variants từ server
    const storageButtons = document.querySelectorAll('.storage-btn');
    const colorButtons = document.querySelectorAll('.color-btn');
    const productImage = document.getElementById('productImage');
    const productPrice = document.getElementById('productPrice');
    const stockStatus = document.querySelector('.stock');

    let selectedStorage = '';
    let selectedColor = '';

    function updateProduct() {
        const variant = variants.find(v => v.storage === selectedStorage && v.color === selectedColor);
        if (variant) {
            productImage.src = variant.image;
            productPrice.textContent = variant.price.toLocaleString() + 'đ';
            if (variant.stock > 0) {
                stockStatus.className = 'stock in-stock';
                stockStatus.textContent = 'Còn hàng';
            } else {
                stockStatus.className = 'stock out-of-stock';
                stockStatus.textContent = 'Hết hàng';
            }
        }
    }

    storageButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            storageButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            selectedStorage = btn.dataset.storage;
            updateProduct();
        });
    });

    colorButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            colorButtons.forEach(b => b.classList.remove('selected'));
            btn.classList.add('selected');
            selectedColor = btn.dataset.color;
            updateProduct();
        });
    });

    if (storageButtons.length) storageButtons[0].click();
    if (colorButtons.length) colorButtons[0].click();
    });

    // Xử lí khi nhấn nút thêm vào giỏ hàng
    function addToCart(prodID) {
        fetch('/cart/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prodID, quantity: 1 })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire({
                    icon: "success",
                    title: "Thành công!", 
                    text: "Sản phẩm đã được thêm vào giỏ hàng.",
                    showConfirmButton: false,
                    timer: 1500,
                    showCloseButton: true
                });
            } else {
                Swal.fire({
                    icon: "warning",
                    html: "<b>Vui lòng đăng nhập tài khoản để xem ưu đãi và thanh toán dễ dàng hơn.</b>",
                    showCancelButton: true,
                    confirmButtonText: "Đăng nhập",
                    cancelButtonText: "Đăng ký",
                    reverseButtons: true,
                    showCloseButton: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = "/login";  // Chuyển đến trang đăng nhập
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        window.location.href = "/register";  // Chuyển đến trang đăng ký
                    }
                });
            }
        });
    }
</script>