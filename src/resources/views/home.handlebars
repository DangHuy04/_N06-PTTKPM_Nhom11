{{!-- Slider Banners Section --}}
<section class="container mt-4">
    <div id="carouselExample1" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            {{#each sliderBanners}}
            <div class="carousel-item {{#if @first}}active{{/if}}">
                <div class="carousel-grid">
                    {{#each this}}
                    <img src="{{this}}" alt="Slider Banner">
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample1" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample1" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</section>

{{!-- iPhone --}}
<div class="container">
    <h1>{{iphone.title}}</h1>
    <div class="grid">
        {{#each iphone.products}}
        <a href="/{{this.productId}}" class="card-link"> 
            <div class="card">
                {{#if this.discount}}
                    <div class="badge discount">{{this.discount}}</div>
                {{/if}}
                {{#if this.installment}}
                    <div class="badge installment">{{this.installment}}</div>
                {{/if}}
                <img src="{{this.image}}" alt="{{this.name}}">
                <h2>{{this.name}}</h2>
                <p class="price">{{this.price}}</p>
                {{#if this.oldPrice}}
                    <p class="old-price">{{this.oldPrice}}</p>
                {{/if}}
            </div>
        </a>
        {{/each}}
    </div>
    <a href="/iphone" class="button">Xem tất cả iPhone</a>
</div>

