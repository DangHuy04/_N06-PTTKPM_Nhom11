<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng Nhập - Apple Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Google Identity Services -->
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <link rel="stylesheet" href="../css/login.css">
</head>

<body>
    {{> header}}

    <section class="login-section vh-100">
        <div class="container py-5 h-100">
            <div class="row d-flex align-items-center justify-content-center h-100">
                <!-- Cột chứa hình ảnh -->
                <div class="col-md-6 col-lg-6 col-xl-6">
                    <img src="../img/login-bg.svg" class="img-fluid" alt="Background Image">
                </div>
                <div class="col-md-4 col-lg-4 col-xl-4">
                    <h1 class="mb-4" style="font-weight:600;color:rgb(93, 14, 189)">Đăng Nhập</h1>
                    <form id="login-form" action="/login" method="POST">
                        <!-- Input tài khoản: nhập email hoặc số điện thoại -->
                        <div class="form-outline mb-4">
                            <label class="form-label" for="login-account">Tài khoản</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person"></i></span>
                                <input type="text" id="login-account" name="account"
                                    class="form-control form-control-lg" placeholder="Nhập Email/SĐt" required>
                            </div>
                        </div>
                        <div id="error-message" class="alert alert-danger" style="display:none"></div>
                        <!-- Input mật khẩu -->
                        <div class="form-outline mb-4">
                            <label class="form-label" for="login-password">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" id="login-password" name="password"
                                    class="form-control form-control-lg" placeholder="Nhập mật khẩu" required>
                            </div>
                        </div>
                        <!-- Nút đăng nhập -->
                        <button type="submit" class="btn btn-primary btn-lg btn-block w-100"
                            style="background:rgb(93, 14, 189)">Đăng Nhập</button>
                        <!-- Divider -->
                        <div class="divider d-flex align-items-center my-4">
                            <span class="fw-bold mx-3 mb-0 text-muted">Hoặc</span>
                        </div>
                        <!-- Google Sign-In button -->
                        <div id="googleSignInButton">
                            <div id="g_id_onload"
                                data-client_id="381875690048-bjt7jpkupdlvanibb6ojpalfbfsto3hs.apps.googleusercontent.com"
                                data-login_uri="http://localhost:3000/google-login-callback" data-auto_prompt="false">
                            </div>
                            <div class="g_id_signin" data-type="standard" data-size="large" data-theme="outline"
                                data-text="sign_in_with" data-shape="rectangular" data-logo_alignment="left">
                            </div>
                        </div>
                        <!-- Nút Quên mật khẩu và Đăng ký đặt ngang hàng -->
                        <div class="d-flex justify-content-between mt-3">
                            <a href="/forgot-password" class="btn btn-link">Quên mật khẩu?</a>
                            <a href="/register" class="btn btn-link">Đăng ký</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    {{> footer}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../js/login.js"></script>
</body>

</html>