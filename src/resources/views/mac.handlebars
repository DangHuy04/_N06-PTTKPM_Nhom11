{{!-- Mac --}}
<div class="container">
    <div class="grid">
        {{#each mac.products}}
        <a href="/{{this.productId}}" class="card-link">
            <div class="card">
                {{#if this.discount}}
                    <div class="badge discount">{{this.discount}}</div>
                {{/if}}
                {{#if this.installment}}
                    <div class="badge installment">{{this.installment}}</div>
                {{/if}}
                <img src="{{this.image}}" alt="{{this.name}}">
                <h2>{{this.name}}</h2>
                <p class="price">{{this.price}}</p>
                {{#if this.oldPrice}}
                    <p class="old-price">{{this.oldPrice}}</p>
                {{/if}}
            </div>
        </a>
        {{/each}}
    </div>
</div>

<div class="container info-section">
    {{#each mac.infoSections}}
    <div class="info-card">
        <img src="{{this.img}}" alt="{{this.title}}">
        <h2>{{this.title}}</h2>
        <a href="{{this.link}}">{{this.linkText}}</a>
    </div>
    {{/each}}
</div>


<div class="container about-section">
    {{#each mac.aboutSections}}
    <div class="about-card">
        <h1>{{this.title1}}</h1>
        <h2>{{this.content1}}</h2>
        <h1>{{this.title2}}</h1>
        <h2>{{this.content2}}</h2>
    </div>
    {{/each}}
</div>


{{!-- Phan review --}}
{{> review reviews=mac.reviews category=category}}

<div class="fixed-buttons">
    <a href="tel:+123456789" class="hotline">
        <i class="bi bi-telephone"></i>
    </a>
    <a href="mailto:example@example.com" class="comment">
        <i class="bi bi-chat-dots"></i>
    </a>
</div>
<script src="../js/page.js"></script>
<link rel="stylesheet" href="../css/mac.css">