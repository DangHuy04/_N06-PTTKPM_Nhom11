{{!-- iPhone --}}
<div class="container text-center">
    <div class="grid">
        {{#each iphone.products}}
        <a href="/{{this.productId}}" class="card-link">
            <div class="card">
                {{#if this.discount}}
                <div class="badge discount">{{this.discount}}</div>
                {{/if}}
                {{#if this.installment}}
                <div class="badge installment">{{this.installment}}</div>
                {{/if}}
                <img src="{{this.image}}" alt="{{this.name}}">
                <h2>{{this.name}}</h2>
                <p class="price">{{this.price}}</p>
                {{#if this.oldPrice}}
                <p class="old-price">{{this.oldPrice}}</p>
                {{/if}}
            </div>
        </a>
        {{/each}}
    </div>
</div>


<div class="container info-section">
    {{#each iphone.infoSections}}
    <div class="info-card">
        <img src="{{this.img}}" alt="{{this.title}}">
        <h2>{{this.title}}</h2>
        <a href="{{this.link}}">{{this.linkText}}</a>
    </div>
    {{/each}}
</div>

<div class="container about-section">
    {{#each iphone.aboutSections}}
    <div class="about-card">
        <h1>{{this.title}}</h1>
        <h2>{{this.content}}</h2>
        <h1>{{this.title}}</h1>
        <h2>{{this.content}}</h2>
    </div>
    {{/each}}
</div>

{{!-- productDetail.handlebars --}}
<div class="container reviews-section">
    <h1 style="margin-left: 3.5vw;">Đánh giá sản phẩm</h1>
    <div class="reviews-grid">
        {{!-- Cột bên trái: Tổng hợp đánh giá và form --}}
        <div class="reviews-summary">
            <div class="rating-card">
                <div class="rating-average">
                    <span class="rating-number">{{reviews.averageRating}}</span>
                    <span class="total-reviews">{{reviews.totalReviews}} đánh giá</span>
                </div>
                <div class="rating-bars">
                    {{#each reviews.ratingCounts}}
                    <div class="rating-bar">
                        <span class="star-count">{{stars}}</span>
                        <div class="progress">
                            <div class="progress-bar" style="width: {{percentage}}%"></div>
                        </div>
                    </div>
                    {{/each}}
                </div>
            </div>

            <div class="review-form">
                <h2>Viết đánh giá của bạn</h2>
                {{#if user}}
                <form id="reviewForm" action="/reviews" method="POST" enctype="multipart/form-data">
                    {{!-- Truyền thông tin danh mục và sản phẩm (nếu có) --}}
                    <input type="hidden" name="category" value="{{category}}">
                    <input type="hidden" name="productId" value="{{productId}}">

                    <div class="rating-select">
                        <span>Chất lượng*:</span>
                        <div class="stars">
                            <input type="radio" id="star1" name="rating" value="1">
                            <label for="star1"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="star2" name="rating" value="2">
                            <label for="star2"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="star3" name="rating" value="3">
                            <label for="star3"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="star4" name="rating" value="4">
                            <label for="star4"><i class="bi bi-star-fill"></i></label>
                            <input type="radio" id="star5" name="rating" value="5" checked>
                            <label for="star5"><i class="bi bi-star-fill"></i></label>
                        </div>
                    </div>

                    <div class="form-group">
                        <h2>Tên của bạn:</h2>
                        <!-- Sử dụng user.username (đã được lưu từ login) -->
                        <input type="text" name="name" value="{{user.username}}" readonly>
                    </div>

                    <div class="form-group">
                        <h2>Nội dung đánh giá:</h2>
                        <textarea name="comment" placeholder="Nhập đánh giá của bạn" required></textarea>
                    </div>

                    <div class="form-group">
                        <label class="upload-btn">
                            <i class="bi bi-upload"></i> Upload hình ảnh
                            <input type="file" name="image" accept="image/*" hidden>
                        </label>
                    </div>

                    <button type="submit" class="submit-btn">Gửi</button>
                </form>
                {{else}}
                <p>Vui lòng <a href="/login">đăng nhập</a> để đánh giá</p>
                {{/if}}
            </div>
        </div>

        {{!-- Cột bên phải: Danh sách các đánh giá đã gửi --}}
        <div class="reviews-list">
            {{#each reviews.list}}
            <div class="review-item">
                <div class="review-avatar">
                    {{#if image}}
                    <img src="{{image}}" alt="{{name}}">
                    {{else}}
                    <i class="bi bi-person-circle"></i>
                    {{/if}}
                </div>
                <div class="review-content">
                    <div class="review-header">
                        <h3>{{name}} <span class="review-date">{{createdAt}}</span></h3>
                    </div>
                    <div class="review-rating">
                        <div class="stars">
                            {{#times rating}}
                            <i class="bi bi-star-fill"></i>
                            {{/times}}
                        </div>
                        <p>{{comment}}</p>
                    </div>
                    {{#if image}}
                    <div class="review-image">
                        <img src="{{image}}" alt="Review image">
                    </div>
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>

    <div class="fixed-buttons">
        <a href="tel:+123456789" class="hotline">
            <i class="bi bi-telephone"></i>
        </a>
        <a href="mailto:example@example.com" class="comment">
            <i class="bi bi-chat-dots"></i>
        </a>
    </div>

    <link rel="stylesheet" href="../css/iphone.css">
    <script>
        document.addEventListener('DOMContentLoaded', function () {
        const reviewForm = document.getElementById('reviewForm');
        if (reviewForm) {
            reviewForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(reviewForm);
                try {
                    const response = await fetch('/reviews', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await response.json();
                    if (result.success) {
                        addNewReview(result.review);
                        reviewForm.reset();
                    } else {
                        alert(result.message);
                    }
                } catch (error) {
                    console.error('Error submitting review:', error);
                    alert('Có lỗi xảy ra khi gửi đánh giá');
                }
            });
        }

        function addNewReview(review) {
            const reviewsList = document.querySelector('.reviews-list');
            const reviewElement = document.createElement('div');
            reviewElement.className = 'review-item';
            reviewElement.innerHTML = `
      <div class="review-avatar">
        ${review.image ? `<img src="${review.image}" alt="${review.name}">` : '<i class="bi bi-person-circle"></i>'}
      </div>
      <div class="review-content">
        <div class="review-header">
          <h3>${review.name} <span class="review-date">${new Date().toLocaleDateString()}</span></h3>
        </div>
        <div class="review-rating">
          <div class="stars">
            ${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}
          </div>
          <p>${review.comment}</p>
        </div>
        ${review.image ? `<div class="review-image"><img src="${review.image}" alt="Review image"></div>` : ''}
      </div>
    `;
            reviewsList.insertBefore(reviewElement, reviewsList.firstChild);
        }
    });

    </script>