<div class="container reviews-section">
  <h1 style="margin-left: 3.5vw;">Đánh giá sản phẩm</h1>
  <div class="reviews-grid">
    <!-- Cột bên trái: Tổng hợp đánh giá và form -->
    <div class="reviews-summary">
      <div class="rating-card">
        <div class="rating-average">
          <span class="rating-number">{{reviews.averageRating}}</span>
          <span class="total-reviews">{{reviews.totalReviews}} đánh giá</span>
        </div>
        <div class="rating-bars">
          {{#each reviews.ratingCounts}}
          <div class="rating-bar">
            <span class="star-count">{{stars}}</span>
            <div class="progress">
              <div class="progress-bar" style="width: {{percentage}}%"></div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>

      <div class="review-form-container">
        <h2>Viết đánh giá của bạn</h2>
        {{#if user}}
        <form class="review-form" action="/reviews" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="category" value="{{category}}">
          <input type="hidden" name="productId" value="{{productId}}">

          <!-- Thanh rating cho người dùng với id duy nhất -->
          <div class="rating-select">
            <span>Chất lượng*:</span>
            <div class="stars">
              <input type="radio" id="star5-{{productId}}" name="rating" value="5" checked>
              <label for="star5-{{productId}}"><i class="bi bi-star-fill"></i></label>

              <input type="radio" id="star4-{{productId}}" name="rating" value="4">
              <label for="star4-{{productId}}"><i class="bi bi-star-fill"></i></label>

              <input type="radio" id="star3-{{productId}}" name="rating" value="3">
              <label for="star3-{{productId}}"><i class="bi bi-star-fill"></i></label>

              <input type="radio" id="star2-{{productId}}" name="rating" value="2">
              <label for="star2-{{productId}}"><i class="bi bi-star-fill"></i></label>

              <input type="radio" id="star1-{{productId}}" name="rating" value="1">
              <label for="star1-{{productId}}"><i class="bi bi-star-fill"></i></label>
            </div>
          </div>

          <div class="form-group">
            <h2>Tên của bạn:</h2>
            <input type="text" name="name" value="{{user.username}}" readonly>
          </div>

          <div class="form-group">
            <h2>Nội dung đánh giá:</h2>
            <textarea name="comment" placeholder="Nhập đánh giá của bạn" required></textarea>
          </div>

          <div class="form-group">
            <label class="upload-btn">
              <i class="bi bi-upload"></i> Upload hình ảnh
              <input type="file" class="reviewImageInput" name="image" accept="image/*" hidden>
            </label>
            <!-- Khu vực preview ảnh -->
            <div class="image-preview-container">
              <img class="imagePreview" alt="Preview" style="display: none;">
            </div>
          </div>

          <button type="submit" class="submit-btn">Gửi</button>
        </form>
        {{else}}
        <p>Vui lòng <a href="/login">đăng nhập</a> để đánh giá</p>
        {{/if}}
      </div>
    </div>

    <!-- Cột bên phải: Danh sách đánh giá -->
    <div class="reviews-list">
      {{#each reviews.list}}
      <div class="review-item">
        <div class="review-avatar">
          {{#if avatar}}
          <img src="{{avatar}}" alt="{{name}}">
          {{else}}
          <i class="bi bi-person-circle"></i>
          {{/if}}
        </div>
        <div class="review-content">
          <div class="review-header">
            <h3>{{name}} <span class="review-date">{{createdAt}}</span></h3>
          </div>
          <div class="review-rating">
            <div class="stars">
              {{#times rating}}
              <i class="bi bi-star-fill"></i>
              {{/times}}
            </div>
            <p>{{comment}}</p>
          </div>
          {{#if image}}
          <div class="review-image">
            <img src="{{image}}" alt="Review image">
          </div>
          {{/if}}
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</div>

<link rel="stylesheet" href="../css/productDetail.css">

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const reviewForm = document.querySelector('.review-form');
    if (reviewForm) {
      const imageInput = reviewForm.querySelector('.reviewImageInput');
      const imagePreview = reviewForm.querySelector('.imagePreview');

      if (imageInput && imagePreview) {
        imageInput.addEventListener('change', function (e) {
          const file = e.target.files[0];
          if (!file) {
            imagePreview.style.display = 'none';
            imagePreview.src = '';
            return;
          }
          const url = URL.createObjectURL(file);
          imagePreview.src = url;
          imagePreview.style.display = 'block';
        });
      }

      reviewForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const formData = new FormData(reviewForm);
        try {
          const response = await fetch(reviewForm.action, {
            method: reviewForm.method,
            body: formData
          });
          const result = await response.json();
          if (result.success) {
            addNewReview(result.review);
            reviewForm.reset();
            if (imagePreview) {
              imagePreview.style.display = 'none';
              imagePreview.src = '';
            }
          } else {
            alert(result.message);
          }
        } catch (error) {
          console.error('Error submitting review:', error);
          alert('Có lỗi xảy ra khi gửi đánh giá');
        }
      });
    }

    function addNewReview(review) {
      const reviewsList = document.querySelector('.reviews-list');
      if (!reviewsList) return;
      const reviewElement = document.createElement('div');
      reviewElement.className = 'review-item';
      reviewElement.innerHTML = `
        <div class="review-avatar">
          ${review.avatar ? `<img src="${review.avatar}" alt="${review.name}">` : '<i class="bi bi-person-circle"></i>'}
        </div>
        <div class="review-content">
          <div class="review-header">
            <h3>${review.name} <span class="review-date">${review.createdAt || new Date().toLocaleDateString()}</span></h3>
          </div>
          <div class="review-rating">
            <div class="stars">
              ${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}
            </div>
            <p>${review.comment}</p>
          </div>
          ${review.image ? `<div class="review-image"><img src="${review.image}" alt="Review image"></div>` : ''}
        </div>
      `;
      reviewsList.insertBefore(reviewElement, reviewsList.firstChild);
    }
  });
</script>
